{
  "manifest_version": 3,
  "name": "Renommeur de téléchargements",
  "version": "1.4.0",
  "description": "Renomme les fichiers téléchargés et déclenche des actions selon des règles personnalisées.",
  "permissions": [
    "downloads",
    "downloads.open",
    "storage",
    "notifications",
    "activeTab"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}